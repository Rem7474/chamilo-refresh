{
  "manifest_version": 3,
  "name": "Chamilo Refresh",
  "version": "1.1.0",
  "description": "Thème sombre/clair lisible, recherche de cours instantanée et favoris pour Chamilo Grenoble INP.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Chamilo Refresh",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chamilo.grenoble-inp.fr/*"
      ],
      "css": [
        "src/theme.css",
        "src/icons.css"
      ],
      "js": [
        "src/settings.js",
        "src/theme.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://chamilo.grenoble-inp.fr/main/document/*"
      ],
      "css": [
        "src/documents.css"
      ],
      "js": [
        "src/documents.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chamilo.grenoble-inp.fr/courses/*"
      ],
      "css": [
        "src/course-home.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chamilo.grenoble-inp.fr/*"
      ],
      "css": [
        "src/courses.css"
      ],
      "js": [
        "src/courses.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
